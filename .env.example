# Values consumed by Docker Compose `${...}` interpolation, and by the
# app during local dev. Keep this file free of `$` characters, otherwise
# Compose will try to interpolate them. Put secrets (bcrypt hash, JWT
# secret) in `.env.secrets` instead.

# --- Storage (only used for local dev, e.g. `uvicorn app.main:app`) ---
# Under Docker Compose these are overridden by docker-compose.yml.
MAPPROXY_CONF_DIR=/data/mapproxy/conf
MAPPROXY_CACHE_DIR=/data/mapproxy/conf/cache_data

# --- URLs exposed in responses (optional) ---
MAPPROXY_PUBLIC_URL=http://localhost:8080

# --- Docker volume host path ---
MAPPROXY_DATA_DIR=./mapproxy_data