# --- Storage ---
MAPPROXY_CONF_DIR=/data/mapproxy/conf
MAPPROXY_CACHE_DIR=/data/mapproxy/conf/cache_data

# --- URLs exposed in responses (optional) ---
MAPPROXY_PUBLIC_URL=http://localhost:8080

# --- Auth ---
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
ADMIN_USERNAME=admin
# Generate with: python -m app.cli hash <password>
ADMIN_PASSWORD_HASH=$2b$12$replace_with_a_real_bcrypt_hash
