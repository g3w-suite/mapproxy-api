# Values with `$` (bcrypt hash, JWT secret) that would break Compose's
# variable interpolation. Delivered to the container verbatim via
# `env_file: format: raw` in the compose files, and read by pydantic-settings
# for local dev (see app/config.py).

JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
ADMIN_USERNAME=admin
# Generate with: python -m app.cli hash <password>
ADMIN_PASSWORD_HASH=$2b$12$replace_with_a_real_bcrypt_hash
